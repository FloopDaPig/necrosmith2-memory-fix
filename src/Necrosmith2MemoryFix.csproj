<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Necrosmith2MemoryFix</AssemblyName>
    <RootNamespace>Necrosmith2MemoryFix</RootNamespace>
    <Description>BepInEx plugin that fixes the memory leak in Necrosmith 2</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.IL2CPP" Version="6.0.0-be.*" />
  </ItemGroup>

</Project>
